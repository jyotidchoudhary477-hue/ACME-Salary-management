# ACME Salary API — copy to .env and adjust as needed
NODE_ENV=development
PORT=4000
HOST=0.0.0.0

# Absolute path or leave empty to use backend/data/acme.db
DB_PATH=

# Seed (`npm run seed`)
SEED_COUNT=10000
SEED_RESET=true
SEED_RNG_SEED=42
SEED_EMAIL_DOMAIN=acme.example
SEED_ACTIVE_RATE=0.94
SEED_HIRE_YEAR_START=2015
SEED_HIRE_YEAR_SPAN=10

# CORS origin for the React app (comma-separated for multiple)
CORS_ORIGIN=http://localhost:5173

# Branding / org defaults
ORG_NAME=ACME Org
APP_NAME=ACME Pay
NOTE_AUTHOR=HR Manager
EMPLOYEE_CODE_PREFIX=ACM
EMPLOYEE_CODE_PAD=5
INITIAL_SALARY_REASON=Initial structure
DEFAULT_SALARY_REASON=Annual revision
DEFAULT_PAGE_SIZE=25
MAX_PAGE_SIZE=100
PAGE_SIZE_OPTIONS=10,25,50

# Auth
JWT_SECRET=acme-dev-secret-change-me
JWT_EXPIRES_IN=7d
DEMO_USER_NAME=Priya Sharma
DEMO_USER_EMAIL=hr@acme.example
DEMO_USER_PASSWORD=password123
DEMO_USER_ROLE=hr
